{
  "name": "delta",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "start:gemini": "node --env-file=.env.gemini.local server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "preindex:gemma": "node --env-file-if-exists=.env.local server/preindex.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "build:extension": "node extension/build.mjs",
    "test:extension": "node --test extension/*.test.js",
    "test:extension:keyboard": "node extension/verify-editable-keyboard.mjs",
    "ui:extension": "app-canvas --config extension/review/canvas.config.mjs",
    "check:ui:extension": "app-canvas --config extension/review/canvas.config.mjs --check",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "ui:review": "app-canvas --config ui-review/canvas.config.mjs",
    "ui:browsers": "node ui-review/install-browser.mjs",
    "check:ui:review": "app-canvas --config ui-review/canvas.config.mjs --check",
    "test:ui:coverage": "node ui-review/verify-coverage.mjs",
    "test:ui:integration": "node ui-review/verify-live-integration.mjs",
    "share:ui": "node ui-review/create-share.mjs",
    "test:ui:review": "app-canvas --config ui-review/canvas.config.mjs --verify"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@tombelieber/app-canvas": "github:tombelieber/app-canvas#v0.4.2",
    "vite": "7.2.4"
  }
}
