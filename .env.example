# Public example. Credentials and deployment identifiers are intentionally empty.
# Keep AI paused until the intended account, route and final candidate qualify.
AI_GENERATION_DISABLED=true
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_TIER_ONLY=true
GEMINI_API_KEY=
GEMINI_API_PROJECT=
GEMINI_API_KEY_RESOURCE=
GOOGLE_CLOUD_PROJECT=
LEARNING_SIGNING_KEY_BASE64=
GEMINI_BILLING_PAUSED=false
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=
ALLOW_CHROME_EXTENSIONS=false
MAX_ANALYSES_PER_HOUR=12
STUDY_ENABLED=false
STUDY_ACCESS_MODE=local
STUDY_ORIGIN=
STUDY_SOURCE_DIR=./artifacts/study/sources
STUDY_CACHE_DIR=./artifacts/study/cache
FIREBASE_PROJECT_ID=
FIREBASE_WEB_CONFIG=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Starter Pack: Sandbox only. Keep disabled until exact-candidate validation.
# Runtime secrets belong in private Secret Manager references, never build inputs/Git.
DELTA_STRIPE_ENABLED=
DELTA_STRIPE_ACCOUNT_ID=
DELTA_STRIPE_RESTRICTED_KEY=
DELTA_STRIPE_WEBHOOK_SECRET=
# Comma-separated verified Firebase UIDs; Sandbox sales fail closed without this allowlist.
DELTA_STRIPE_TEST_UIDS=
